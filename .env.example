CMC_API_KEY=your_coinmarketcap_pro_api_key
HYPE_WALLET_ADDRESS=0xYourWalletAddress
HYPE_PRIVATE_KEY=0xYourPrivateKey
# Railway / cloud instance (separate Hyperliquid account):
# HYPE_WALLET_ADDRESS_CLOUD=0xYourCloudWalletAddress
# HYPE_PRIVATE_KEY_CLOUD=0xYourCloudAgentKey
ANTHROPIC_API_KEY=your_anthropic_api_key

# Local backtest backup (read-only Neon).
# ROI-ranked collector (portfolio_data_collection):
# NEON_BAGRANK=postgresql://USER:PASS@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# PnL-ranked collector (portfolio_data_collection_pnl) — separate Neon project:
# NEON_PNL=postgresql://USER:PASS@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Railway live uses HYPE_WALLET_ADDRESS + HYPE_PRIVATE_KEY (real orders).
# One-shot lookback at boot (finished hours only), then Hyperliquid rolling window:
# NEON_DATABASE=postgresql://USER:PASS@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# NEON_DATABASE_PNL=postgresql://USER:PASS@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# (PnL URI is the PnL collector project — same as NEON_PNL. Not NEON_DATABASE / ROI.)
# BAGRANK_SQLITE=data/bagrank/bagrank.sqlite
# PNL_SQLITE=data/pnlrank/pnlrank.sqlite
# BAGRANK_LIVE_SQLITE=data/bagrank/live.sqlite
